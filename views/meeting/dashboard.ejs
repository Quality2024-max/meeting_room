<%- include('../partials/header', { title: 'Dashboard' }) %>
<%- include('../partials/navbar') %>
<main class="container page">
<%
  const fmtSize = (b) => { b = Number(b); return b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB'; };
  const fmtDur = (s) => Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
%>
<%
  const total = meetings.length;
  const live = meetings.filter((m) => m.status === 'live').length;
  const upcoming = meetings.filter((m) => m.status === 'scheduled').length;
  const recCount = Object.values(recordings).reduce((n, list) => n + list.length, 0);
%>
<div class="dash-head">
  <div>
    <h1>Hello, <%= user.name.split(' ')[0] %></h1>
    <p>Here is what is happening with your interviews and meetings.</p>
  </div>
  <a class="btn lg" href="/meetings/new">+ Schedule a session</a>
</div>

<section class="stats" aria-label="Summary">
  <div class="stat"><b><%= total %></b><span>Total sessions</span></div>
  <div class="stat"><b><%= upcoming %></b><span>Upcoming</span></div>
  <div class="stat"><b><%= live %></b><span>Live now</span></div>
  <div class="stat"><b><%= recCount %></b><span>Recordings</span></div>
</section>

<form method="post" action="/join" class="join">
  <input type="text" name="code" placeholder="Have a room code? Paste it here">
  <button class="btn ghost" type="submit">Join room</button>
</form>
<% if (joinError) { %><p class="alert"><%= joinError %></p><% } %>

<% if (!meetings.length) { %>
  <div class="empty">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
    <h2>No sessions yet</h2>
    <p>Schedule your first interview or meeting to get a shareable room code.</p>
    <a class="btn" href="/meetings/new">Schedule a session</a>
  </div>
<% } %>

<% meetings.forEach(m => { %>
  <article class="card session">
    <div class="row between">
      <div>
        <h2><%= m.title %></h2>
        <p class="muted">
          <span class="type-chip <%= m.type %>"><%= m.type === 'interview' ? 'Interview' : 'Meeting' %></span>
          <% if (m.candidate_name) { %>with <%= m.candidate_name %> &middot; <% } %>
          <%= m.scheduled_at %> (<%= m.duration_min %> min)
        </p>
        <p class="muted">Room code: <code><%= m.room_code %></code></p>
        <% if (m.status !== 'ended') { %>
          <div class="link-row">
            <span class="muted">Meeting link:</span>
            <input type="text" class="link-input" readonly aria-label="Meeting link"
              value="<%= baseUrl %>/join/<%= m.room_code %>">
            <button type="button" class="btn ghost sm" data-copy-link>Copy link</button>
          </div>
        <% } %>
      </div>
      <span class="badge <%= m.status %>"><%= m.status %></span>
    </div>

    <div class="row actions">
      <% if (m.status !== 'ended') { %>
        <a class="btn" href="/room/<%= m.room_code %>"><%= m.status === 'live' ? 'Rejoin room' : 'Start room' %></a>
        <%
          const whenTxt = String(m.scheduled_at).slice(0, 16);
          const kind = m.type === 'interview' ? 'interview' : 'meeting';
          const defaultMsg = 'Hi,\n\nYou are invited to a ' + kind + ' "' + m.title + '" on ' + whenTxt + ' (' + m.duration_min + ' min).\n\nPlease use the link below to join. You do not need an account - just enter your name when you open it.\n\nRegards,\n' + user.name;
        %>
        <button class="btn ghost" type="button" data-invite
          data-id="<%= m.id %>"
          data-title="<%= m.title %>"
          data-code="<%= m.room_code %>"
          data-candidate="<%= m.candidate_name || '' %>"
          data-message="<%= defaultMsg %>"
          data-subject="<%= (m.type === 'interview' ? 'Interview invitation: ' : 'Meeting invitation: ') + m.title %>">Invite candidates</button>
        <form method="post" action="/meetings/<%= m.id %>/end"><button class="btn ghost" type="submit">End session</button></form>
      <% } %>
      <form method="post" action="/meetings/<%= m.id %>/delete" onsubmit="return confirm('Delete this session and its chat?')">
        <button class="btn danger" type="submit">Delete</button>
      </form>
    </div>

    <% if (recordings[m.id]) { %>
      <div class="recordings">
        <h3>Recordings</h3>
        <% recordings[m.id].forEach(r => { %>
          <div class="row rec-row">
            <span class="muted"><%= r.created_at %> &middot; <%= fmtDur(r.duration_sec) %> &middot; <%= fmtSize(r.size_bytes) %></span>
            <a class="btn ghost" href="/recordings/<%= r.id %>" target="_blank" rel="noopener">Play</a>
            <a class="btn ghost" href="/recordings/<%= r.id %>?download=1">Download</a>
            <form method="post" action="/recordings/<%= r.id %>/delete" onsubmit="return confirm('Delete this recording?')">
              <button class="btn danger" type="submit">Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (m.type === 'interview') { %>
      <form method="post" action="/meetings/<%= m.id %>/feedback" class="row feedback">
        <select name="rating">
          <option value="">Rating</option>
          <% for (let i = 1; i <= 5; i++) { %><option value="<%= i %>" <%= m.rating === i ? 'selected' : '' %>><%= i %> / 5</option><% } %>
        </select>
        <input type="text" name="feedback" value="<%= m.feedback || '' %>" placeholder="Interview feedback">
        <button class="btn ghost" type="submit">Save feedback</button>
      </form>
    <% } %>
  </article>
<% }) %>

<dialog id="inviteDialog" class="modal">
  <form id="inviteForm" method="dialog">
    <div class="modal-head">
      <h2>Invite candidates</h2>
      <button type="button" class="modal-x" id="inviteClose" aria-label="Close">&times;</button>
    </div>
    <p class="muted" id="inviteFor"></p>

    <label>Candidate email(s)
      <textarea name="emails" id="inviteEmails" rows="2" placeholder="a@example.com, b@example.com" required></textarea>
      <small class="muted">Separate several emails with a comma, space or new line (max 20).</small>
    </label>
    <label>Subject
      <input type="text" name="subject" id="inviteSubject" maxlength="200" required>
    </label>
    <label>Email message
      <textarea name="message" id="inviteMessage" rows="8" required></textarea>
    </label>
    <p class="invite-note">The <b>join link</b> and the <b>meeting code</b> are added to the email automatically.</p>

    <p class="alert" id="inviteError" role="alert" hidden></p>
    <p class="ok-box" id="inviteOk" role="status" hidden></p>

    <div class="form-actions">
      <button type="button" class="btn ghost" id="inviteCancel">Close</button>
      <button type="submit" class="btn" id="inviteSend">Send invitation</button>
    </div>
  </form>
</dialog>
<script src="/js/invite.js"></script>
<script src="/js/copylink.js"></script>
</main>
<%- include('../partials/footer') %>
