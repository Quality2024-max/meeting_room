<%- include('../partials/header', { title: 'Join meeting' }) %>
<%- include('../partials/navbar') %>
<main class="container page">
  <div class="form-shell">
    <section class="card form-card">
      <h1>Join: <%= meeting.title %></h1>
      <p>
        <span class="type-chip <%= meeting.type %>"><%= meeting.type === 'interview' ? 'Interview' : 'Meeting' %></span>
        <%= String(meeting.scheduled_at).slice(0, 16) %> (<%= meeting.duration_min %> min)
      </p>
      <p class="muted">No account needed. Enter your name so the host knows who you are.</p>
      <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
      <form method="post" action="/join/<%= encodeURIComponent(meeting.room_code) %>">
        <div class="form-grid">
          <label class="full">Your name
            <input type="text" name="name" value="<%= name %>" placeholder="e.g. Priya Sharma" maxlength="60" required autofocus autocomplete="name">
          </label>
        </div>
        <div class="form-actions">
          <button class="btn lg block" type="submit">Join meeting</button>
        </div>
      </form>
      <p class="muted" style="margin-top:14px">Meeting code: <code><%= meeting.room_code %></code> &middot; Have an account? <a href="/login">Log in</a></p>
    </section>
  </div>
</main>
<%- include('../partials/footer') %>
